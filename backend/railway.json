{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS_PYTHON",
    "buildPackDebianPackages": ["libsndfile1"]
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyRetries": 10
  },
  "start": {
    "cmd": "uvicorn main:app --host 0.0.0.0 --port $PORT"
  }
}